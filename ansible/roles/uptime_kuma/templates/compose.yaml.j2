services:
  uptime-kuma:
    image: louislam/uptime-kuma:{{ uptime_kuma_version }}
    container_name: {{ uptime_kuma_container_name }}
    restart: {{ uptime_kuma_restart_policy }}

    ports:
      - "{{ uptime_kuma_host }}:{{ uptime_kuma_port }}:{{ uptime_kuma_container_port }}"

    volumes:
      - {{ uptime_kuma_data_dir }}:/app/data

    init: true